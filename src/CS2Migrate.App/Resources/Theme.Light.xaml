<!-- Light theme tokens. Values follow the Windows 11 (WinUI 2.6+) common resource palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EBEBEB" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlStrokeStrongBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#17000000" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#767676" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A0A0" />

    <!-- Accent (overridden at runtime with the user's Windows accent colour) -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#1A6FBF" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#3380C6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#003E92" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#C6E6C4" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="CautionStrokeBrush" Color="#F0E0A8" />
    <SolidColorBrush x:Key="CautionForegroundBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="CriticalStrokeBrush" Color="#F3C9CD" />
    <SolidColorBrush x:Key="CriticalForegroundBrush" Color="#C42B1C" />

    <!-- Misc -->
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5D5D5D" />
</ResourceDictionary>
