<Window x:Class="CS2Migrate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CS2Migrate.App"
        Title="{DynamicResource AppTitle}" Width="1060" Height="820" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>

        <!-- One account row, reused for the closed combo box and for its drop-down items. -->
        <DataTemplate x:Key="AccountTemplate">
            <Grid MinWidth="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="28" Height="28" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AccountIdentity}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1"
                        Visibility="{Binding IsMostRecent, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource Recent}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Shown under a picker. A null account renders nothing, so the row disappears
             instead of leaving a stray status dot behind. -->
        <DataTemplate x:Key="AccountHealthTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource CautionForegroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HealthSeverity}" Value="{x:Static local:StatusSeverity.Success}">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConfigSummary}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PreviewFileTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFontFamily}" FontSize="14"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,10,0"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="2" CornerRadius="4" Padding="6,1"
                        Background="{DynamicResource CardBackgroundSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Action}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Info bar: neutral surface, with the severity carried by the border and the glyph. -->
        <Style x:Key="InfoBarStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Success}">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessStrokeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Caution}">
                    <Setter Property="BorderBrush" Value="{DynamicResource CautionStrokeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Critical}">
                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoBarGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource GlyphTextStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Success}">
                    <Setter Property="Text" Value="&#xE930;" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Caution}">
                    <Setter Property="Text" Value="&#xE7BA;" />
                    <Setter Property="Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SafetySeverity}" Value="{x:Static local:StatusSeverity.Critical}">
                    <Setter Property="Text" Value="&#xE783;" />
                    <Setter Property="Foreground" Value="{DynamicResource CriticalForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommandGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,1,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Margin="28,18,28,10" MaxWidth="1120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AccentFillBrush}">
                    <TextBlock Text="&#xE8AB;" FontFamily="{DynamicResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- Literal: the product name is not translated, and routing it through a
                         resource lookup left the line blank. -->
                    <TextBlock Text="CS2 Migrate" FontSize="18" FontWeight="SemiBold"
                               FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Slogan}" FontSize="12" FontFamily="Segoe UI"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="4" Padding="10,6" Margin="0,0,10,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnvironmentSeverity}" Value="{x:Static local:StatusSeverity.Success}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EnvironmentSeverity}" Value="{x:Static local:StatusSeverity.Caution}">
                                            <Setter Property="Fill" Value="{DynamicResource CautionForegroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EnvironmentSeverity}" Value="{x:Static local:StatusSeverity.Critical}">
                                            <Setter Property="Fill" Value="{DynamicResource CriticalForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding EnvironmentStatus}" FontSize="12" FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Click="Refresh_Click" Margin="0,0,8,0" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource CommandGlyphStyle}" />
                        <TextBlock Text="{DynamicResource Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="Language_Click" ToolTip="{DynamicResource SwitchLanguage}"
                        Padding="12,5" MinWidth="66">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource CommandGlyphStyle}" />
                        <TextBlock Text="{Binding LanguageButtonLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Content ============
             Cards keep their natural height and the page scrolls when it has to, the way a
             Windows settings page behaves. Stretching the last card to fill a maximised
             window just produced a large empty panel. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,6,28,20" MaxWidth="1120">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Safety info bar -->
            <Border Style="{StaticResource InfoBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource InfoBarGlyphStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SafetyTitle}" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock Text="{Binding SafetyDetail}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="CloseSteam_Click" VerticalAlignment="Center"
                            Visibility="{Binding HasBlockingProcesses, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource CommandGlyphStyle}" />
                            <TextBlock Text="{DynamicResource CloseSteamSafely}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Accounts -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ChooseAccountsTitle}" Style="{StaticResource SubtitleTextStyle}" />
                            <TextBlock Text="{DynamicResource ChooseAccountsDetail}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                Click="ChooseSteamFolder_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource CommandGlyphStyle}" />
                                <TextBlock Text="{DynamicResource ChooseSteamFolder}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource CopyFrom}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedSource}"
                                  ItemTemplate="{StaticResource AccountTemplate}" Tag="{DynamicResource ChooseAccount}" />
                        <ContentControl Grid.Row="2" Content="{Binding SelectedSource}"
                                        ContentTemplate="{StaticResource AccountHealthTemplate}" />

                        <Button Grid.Column="1" Grid.Row="1" Style="{StaticResource IconButtonStyle}"
                                Content="&#xE8AB;" Margin="12,0,12,0" Click="Swap_Click"
                                ToolTip="{DynamicResource SwapAccounts}" />

                        <TextBlock Grid.Column="2" Text="{DynamicResource CopyTo}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedTarget}"
                                  ItemTemplate="{StaticResource AccountTemplate}" Tag="{DynamicResource ChooseAccount}" />
                        <ContentControl Grid.Column="2" Grid.Row="2" Content="{Binding SelectedTarget}"
                                        ContentTemplate="{StaticResource AccountHealthTemplate}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What moves -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource WhatMovesTitle}" Style="{StaticResource SubtitleTextStyle}" />
                    <TextBlock Text="{DynamicResource WhatMovesDetail}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,12" />

                    <UniformGrid Columns="4" Rows="1">
                        <CheckBox Style="{StaticResource OptionCardCheckBoxStyle}" IsChecked="{Binding IncludeGameplay}" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Gameplay}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{DynamicResource GameplayDetail}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource OptionCardCheckBoxStyle}" IsChecked="{Binding IncludeKeybinds}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Keybinds}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{DynamicResource KeybindsDetail}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource OptionCardCheckBoxStyle}" IsChecked="{Binding IncludeVideo}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Video}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{DynamicResource VideoDetail}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource OptionCardCheckBoxStyle}" IsChecked="{Binding IncludeAutoexec}" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Autoexec}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{DynamicResource AutoexecDetail}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                    </UniformGrid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,12" />

                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsTemporarySession}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FriendMode}" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{DynamicResource FriendModeDetail}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource PreviewTitle}" Style="{StaticResource SubtitleTextStyle}" />
                            <TextBlock Text="{Binding PreviewSummary}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding PreviewSize}" FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,6" MinHeight="84" MaxHeight="260">
                        <ListBox ItemsSource="{Binding PreviewFiles}" ItemTemplate="{StaticResource PreviewFileTemplate}"
                                 Margin="-8,0,-8,0" />
                        <TextBlock Text="{DynamicResource PreviewEmpty}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewFiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="{DynamicResource PreviewBackupDetail}" Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ============ Command bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid MaxWidth="1120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ActivityTitle}" Style="{StaticResource BodyStrongTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ActivityDetail}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button IsEnabled="{Binding CanBackupTarget}" Click="BackupTarget_Click" Margin="0,0,8,0"
                            ToolTip="{DynamicResource BackupTargetTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource CommandGlyphStyle}" />
                            <TextBlock Text="{DynamicResource BackupTarget}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding CanOpenHistory}" Click="History_Click" Margin="0,0,8,0"
                            ToolTip="{DynamicResource HistoryTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource CommandGlyphStyle}" />
                            <TextBlock Text="{DynamicResource History}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenBackups_Click" Margin="0,0,16,0"
                            ToolTip="{DynamicResource OpenBackupsTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource CommandGlyphStyle}" />
                            <TextBlock Text="{DynamicResource OpenBackups}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding MigrationButtonText}"
                            IsEnabled="{Binding CanMigrate}" Click="Migrate_Click" MinWidth="170" Padding="18,5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
