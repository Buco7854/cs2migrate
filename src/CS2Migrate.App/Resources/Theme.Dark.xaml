<!-- Dark theme tokens. Values follow the Windows 11 (WinUI 2.6+) common resource palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#272727" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="DividerBrush" Color="#333333" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ControlStrokeStrongBrush" Color="#767676" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0BFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#969696" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E6E" />

    <!-- Accent (overridden at runtime with the user's Windows accent colour) -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#55B9E6" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#4CA6CC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#99EBFF" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#393D1B" />
    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#46491F" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#433519" />
    <SolidColorBrush x:Key="CautionStrokeBrush" Color="#4E3E1E" />
    <SolidColorBrush x:Key="CautionForegroundBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#442726" />
    <SolidColorBrush x:Key="CriticalStrokeBrush" Color="#4F2C2B" />
    <SolidColorBrush x:Key="CriticalForegroundBrush" Color="#FF99A4" />

    <!-- Misc -->
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9F9F9F" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#CFCFCF" />
</ResourceDictionary>
