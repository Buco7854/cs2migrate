<Window x:Class="CS2Migrate.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HistoryWindowTitle}" Width="860" Height="620"
        MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="RestorePointTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RestoreFileTemplate">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,12">
            <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Text="{DynamicResource HistoryLead}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <ListBox x:Name="PointList" ItemsSource="{Binding RestorePoints}"
                             SelectedItem="{Binding SelectedPoint}"
                             ItemTemplate="{StaticResource RestorePointTemplate}"
                             ItemContainerStyle="{StaticResource SelectableListBoxItemStyle}" />
                    <TextBlock Text="{DynamicResource HistoryEmpty}" Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource HistoryFilesTitle}" Style="{StaticResource SubtitleTextStyle}" />
                        <TextBlock Text="{DynamicResource HistoryFilesDetail}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedPoint.Files}"
                             ItemTemplate="{StaticResource RestoreFileTemplate}" Margin="-8,10,-8,0" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource SelectAll}"
                                Click="SelectAll_Click" Padding="10,4" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource SelectNone}"
                                Click="SelectNone_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource HistoryFooter}" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource CloseButton}" Click="Close_Click" Margin="0,0,8,0" MinWidth="90" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{DynamicResource RestoreSelected}"
                            Click="Restore_Click" IsEnabled="{Binding CanRestore}" MinWidth="170" Padding="18,5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
