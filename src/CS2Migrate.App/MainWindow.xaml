<Window x:Class="CS2Migrate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Width="1180" Height="810" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>
        <DataTemplate x:Key="AccountOptionTemplate">
            <Grid Margin="0,2" MinWidth="290">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" ClipToBounds="True">
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F5F7FB" />
                    <TextBlock Text="{Binding AccountIdentity}" FontSize="10.5" Foreground="#95A3BB" />
                </StackPanel>
                <Border Grid.Column="2" Background="#183D38" CornerRadius="8" Padding="7,3"
                        Visibility="{Binding IsMostRecent, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource Recent}" Foreground="#63E5D7" FontSize="9" FontWeight="Bold" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SelectedAccountTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="17" ClipToBounds="True" VerticalAlignment="Top">
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AccountIdentity}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConfigSummary}" Foreground="#B7C3D7" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,25,32,19">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="13">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7868FF" Offset="0" />
                            <GradientStop Color="#27D8C5" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Path Data="M 12 17 L 28 17 M 23 12 L 28 17 L 23 22 M 34 29 L 18 29 M 23 24 L 18 29 L 23 34"
                              Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CS2 MIGRATE" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource Slogan}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#111B2C" BorderBrush="#26334C" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding EnvironmentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EnvironmentStatus}" Foreground="#C8D1E1" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Button Content="{Binding LanguageButtonLabel}" ToolTip="{DynamicResource SwitchLanguage}"
                        Click="Language_Click" Margin="0,0,9,0" MinWidth="44" />
                <Button Content="{DynamicResource Refresh}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,22">
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ChooseAccountsTitle}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource ChooseAccountsDetail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource ChooseSteamFolder}" Click="ChooseSteamFolder_Click" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{DynamicResource Source}" Foreground="#7F8DA6" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedSource}"
                                          ItemTemplate="{StaticResource AccountOptionTemplate}" Margin="0,0,0,14" />
                                <Border Background="#0D1423" BorderBrush="#222E44" BorderThickness="1" CornerRadius="13" Padding="16">
                                    <ContentControl Content="{Binding SelectedSource}" ContentTemplate="{StaticResource SelectedAccountTemplate}" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Width="42" Height="42" Padding="0" Click="Swap_Click"
                                    VerticalAlignment="Center" ToolTip="{DynamicResource SwapAccounts}">
                                <Path Data="M 8 13 L 26 13 M 21 8 L 26 13 L 21 18 M 26 25 L 8 25 M 13 20 L 8 25 L 13 30"
                                      Stroke="#DCE3F1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Target}" Foreground="#7F8DA6" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedTarget}"
                                          ItemTemplate="{StaticResource AccountOptionTemplate}" Margin="0,0,0,14" />
                                <Border Background="#0D1423" BorderBrush="#222E44" BorderThickness="1" CornerRadius="13" Padding="16">
                                    <ContentControl Content="{Binding SelectedTarget}" ContentTemplate="{StaticResource SelectedAccountTemplate}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WhatMovesTitle}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource WhatMovesDetail}"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,15" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Rows="2">
                                <CheckBox Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding IncludeGameplay}" Margin="0,0,6,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Gameplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource GameplayDetail}" Foreground="#8492AA" FontSize="10.5" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding IncludeKeybinds}" Margin="6,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Keybinds}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource KeybindsDetail}" Foreground="#8492AA" FontSize="10.5" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding IncludeVideo}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Video}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource VideoDetail}" Foreground="#8492AA" FontSize="10.5" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding IncludeAutoexec}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Autoexec}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource AutoexecDetail}" Foreground="#8492AA" FontSize="10.5" />
                                    </StackPanel>
                                </CheckBox>
                            </UniformGrid>
                            <CheckBox Style="{StaticResource ToggleCheckStyle}" IsChecked="{Binding IsTemporarySession}" Margin="0,11,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource FriendMode}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource FriendModeDetail}" Foreground="#8492AA" FontSize="10.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource PreviewTitle}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PreviewSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B2440" CornerRadius="9" Padding="9,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PreviewSize}" Foreground="#BFC8FF" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding PreviewFiles}" Background="Transparent" BorderThickness="0"
                                     Foreground="#CED6E6" Margin="-3,12,-3,8" MaxHeight="108" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5" Height="5" Fill="#34D6C7" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="#75839B" FontSize="10" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2" Text="{DynamicResource PreviewBackupDetail}"
                                       Foreground="#7F8DA6" FontSize="10.5" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="{Binding SafetyBackground}" BorderBrush="{Binding SafetyBorder}" BorderThickness="1"
                        CornerRadius="13" Padding="15,12" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{Binding SafetyIconBackground}" Margin="0,0,11,0">
                            <TextBlock Text="{Binding SafetyIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SafetyTitle}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding SafetyDetail}" Foreground="#9EABC0" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{DynamicResource CloseSteamSafely}" Click="CloseSteam_Click"
                                Visibility="{Binding HasBlockingProcesses, Converter={StaticResource BoolToVisibility}}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0B1120" BorderBrush="#1E2A40" BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock Text="{Binding ActivityDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource BackupTarget}" IsEnabled="{Binding CanBackupTarget}"
                            Click="BackupTarget_Click" Margin="0,0,9,0" />
                    <Button Content="{DynamicResource RestoreLatest}" IsEnabled="{Binding CanRestoreTarget}"
                            Click="RestoreTarget_Click" Margin="0,0,9,0" />
                    <Button Content="{DynamicResource OpenBackups}" Click="OpenBackups_Click" Margin="0,0,9,0" />
                    <Button Content="{Binding MigrationButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanMigrate}" Click="Migrate_Click" MinWidth="164" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
